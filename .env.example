# Copie para .env e ajuste. O .env nunca vai para o git.

NODE_ENV=development
PORT=3333

# Postgres do docker-compose.dev.yml (npm run services:up)
DATABASE_URL=postgres://cifra:cifra@localhost:5433/cifra_kindle_dev
# O nome do banco de teste PRECISA conter "_test".
DATABASE_URL_TEST=postgres://cifra:cifra@localhost:5433/cifra_kindle_test
# DATABASE_POOL_MIN=2
# DATABASE_POOL_MAX=10

# Serviço FastAPI de scraping do Cifra Club (scraper/).
SCRAPER_BASE_URL=http://localhost:8000

# Envio para o Kindle via SMTP (CAP-4). Sem estas 3 variáveis o pipeline termina
# em status=erro na etapa "enviando" ("Configuração SMTP incompleta").
# Gmail pessoal com App Password (conta com verificação em 2 etapas):
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
# 587 = STARTTLS; 465 = TLS direto (o cliente ativa `secure` só na 465).
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# E-mail Send-to-Kindle do aparelho (Amazon > Conteúdo e dispositivos > Preferências).
# SMTP_USER precisa estar cadastrado como "Approved Sender" nessa mesma conta (C-11).
KINDLE_EMAIL_TO=

# Portas no host usadas só pelo docker-compose.dev.yml (valores padrão abaixo).
# API_PORT=3333
# WEB_PORT=3010
