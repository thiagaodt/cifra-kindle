# Imagem de DESENVOLVIMENTO da API (tsx watch). Não é a de produção — o MVP
# roda só em localhost (C-14), não há deploy em nuvem.
#
# Usada pelo docker-compose.dev.yml (perfil `app`). O código chega ao container
# pelo Compose Watch (`sync`), não por bind mount: no Windows o bind mount não
# propaga eventos de arquivo para o Linux e o `tsx watch` não recarregaria.

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=development

COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts

COPY . .

EXPOSE 3333
CMD ["npm", "run", "dev"]
