{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022"],
        "module": "CommonJS",
        "moduleResolution": "bundler",
        "rootDir": ".",
        "outDir": "dist",
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "noImplicitOverride": true,
        "noFallthroughCasesInSwitch": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "sourceMap": true,
        "declaration": false
    },
    "include": [
        "*.ts",
        "config/**/*.ts",
        "controllers/**/*.ts",
        "database/**/*.ts",
        "integrations/**/*.ts",
        "interfaces/**/*.ts",
        "migrations/**/*.ts",
        "repositories/**/*.ts",
        "routes/**/*.ts",
        "schemas/**/*.ts",
        "scripts/**/*.ts",
        "services/**/*.ts",
        "tests/**/*.ts"
    ],
    "exclude": ["node_modules", "dist", "apps"]
}
