# Imagem de DESENVOLVIMENTO do scraper (uvicorn --reload). Não é a de
# produção — o MVP roda só em localhost (C-14), não há deploy em nuvem.

FROM python:3.12-slim
WORKDIR /app

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

EXPOSE 8000
CMD ["uvicorn", "main:app", "--reload", "--host", "0.0.0.0", "--port", "8000"]
