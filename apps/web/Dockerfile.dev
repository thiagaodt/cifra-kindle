# Imagem de DESENVOLVIMENTO do front (`next dev`). Não é a de produção.
# Contexto de build = apps/web (não a raiz do repo).
#
# Usada pelo docker-compose.dev.yml (perfil `app`). O código chega pelo Compose
# Watch (`sync`), não por bind mount: no Windows o bind mount não propaga eventos
# de arquivo e o Next não recarregaria.

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=development
ENV NEXT_TELEMETRY_DISABLED=1

COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts

COPY . .

EXPOSE 3010
CMD ["npm", "run", "dev"]
